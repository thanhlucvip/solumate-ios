PORT=4200
HOST=127.0.0.1
STREAM_AUTH_TOKEN=
ALLOWED_ORIGIN=
WDA_BASE=http://127.0.0.1:8000
MJPEG_URL=http://127.0.0.1:8001
H264_TCP_URL=tcp://127.0.0.1:8002
WDA_REALTIME_CONTROL_HOST=127.0.0.1
WDA_REALTIME_CONTROL_PORT=8003
MJPEG_FRAMERATE=30
MJPEG_QUALITY=20
MJPEG_SCALE=45
MJPEG_FIX_ORIENTATION=true
MJPEG_WS_MAX_BUFFERED_BYTES=262144

# Optional: enable H264-based view modes (Broadway/h264-live-player/tinyh264)
# H264_WS_URL=ws://127.0.0.1:27183
# H264_TCP_URL=tcp://127.0.0.1:8002

# Optional: realtime control socket for TrollStore/manual-launch WDA
# WDA_AUTH_TOKEN=
# WDA_REALTIME_CONTROL_HOST=127.0.0.1
# WDA_REALTIME_CONTROL_PORT=8003

# Optional: dedicated scrcpy websocket source for "Genymobile/scrcpy" mode
# SCRCPY_WS_URL=ws://127.0.0.1:27184

# Optional: local MJPEG -> H264 fallback (used when upstream websocket is absent/unreachable)
# LOCAL_H264_FALLBACK=true
# LOCAL_H264_FPS=30
# LOCAL_H264_GOP=30
# LOCAL_H264_MAX_WIDTH=720
# LOCAL_H264_MAX_HEIGHT=1280
# FFMPEG_PATH=ffmpeg
# LOCAL_H264_ENCODER=libx264

# Optional: enable WebRTC mode (WHEP endpoint)
# WEBRTC_WHEP_URL=http://127.0.0.1:8889/whep

# Optional: allow passing dynamic upstream/source in websocket query params
# ALLOW_DYNAMIC_WS_SOURCE=false

# Optional: default secret used by /api/point-array to auto-build `st` when UI token is empty
# SOLUMATE_WDA_SWIPE_SECRET=
# SOLUMATE_WDA_ENABLE_POINT_ARRAY=1
# SOLUMATE_WDA_ALLOW_UNSIGNED_POINT_ARRAY=false

# Optional: trackpad_server.js uses STREAM_AUTH_TOKEN by default; override only if needed
# TRACKPAD_AUTH_TOKEN=
